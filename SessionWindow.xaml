<Window x:Class="FocusStudy.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Study" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Background="{StaticResource Bg}"
        FontFamily="Segoe UI" Foreground="{StaticResource Text}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootGrid" Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Exit steps: a side panel, so the study stays in view while deciding ============ -->
        <Border x:Name="ExitCard" Grid.Column="1" Width="420" Visibility="Collapsed" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0" PreviewKeyDown="ExitCard_PreviewKeyDown">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,34,30,30">
                    <Border Background="#141B2E" BorderBrush="#25335A" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,26">
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Text}" LineHeight="20">
                            <Run Text="←" FontSize="16" Foreground="{StaticResource Accent}"/>
                            <Run Text=" Your work is still open. Look at it before you decide."/>
                            <LineBreak/>
                            <Run Foreground="{StaticResource Muted}" Text="Could you finish just this one part first?"/>
                        </TextBlock>
                    </Border>

                    <TextBlock x:Name="ExitStepLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource H1}" FontSize="21" Text="Leave the focus session early?"/>

                    <StackPanel x:Name="ExitStep1">
                        <TextBlock Style="{StaticResource Body}" Text="Why are you stopping? Be honest with yourself (at least 20 characters)."/>
                        <TextBox x:Name="ExitReason" Height="90" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,12,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="ExitStep2">
                        <TextBlock Style="{StaticResource Body}" Text="Type this sentence exactly. Pasting is disabled."/>
                        <TextBlock x:Name="ExitPhrase" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBox x:Name="ExitPhraseBox" Margin="0,12,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="ExitStep3">
                        <TextBlock Style="{StaticResource Body}" Text="Solve this without a calculator:"/>
                        <TextBlock x:Name="ExitMathQ" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBox x:Name="ExitMathBox" Width="180" HorizontalAlignment="Left" FontSize="16" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="ExitStep4">
                        <TextBlock Style="{StaticResource Body}" Text="Take a breath and look at your work. Unlock becomes available when the bar fills, and you can still change your mind."/>
                        <ProgressBar x:Name="ExitProgress" Height="8" Margin="0,18,0,0" Foreground="{StaticResource Accent}" Background="#232836" BorderThickness="0"/>
                        <TextBlock x:Name="ExitCooldownText" Style="{StaticResource Body}" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="ExitError" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="Stay focused" Style="{StaticResource Primary}" Click="ExitStay_Click" Padding="18,9" Margin="0,0,8,8"/>
                        <Button x:Name="ExitNext" Content="Next" Click="ExitNext_Click" Padding="18,9" Margin="0,0,8,8"/>
                        <Button x:Name="ExitUnlock" Content="Unlock and end session" Style="{StaticResource DangerBtn}" Click="ExitUnlock_Click" Padding="18,9" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ Main shell ============ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Top bar: no clock, no countdown, by design -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="FocusDot" Width="10" Height="10" Fill="{StaticResource Good}" Margin="0,0,10,0"/>
                        <TextBlock Text="Focus" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="0,0,26,0"/>
                        <Button x:Name="NavBrowser" Content="Browser" Tag="browser" Click="Nav_Click" Style="{StaticResource Ghost}"/>
                        <Button x:Name="NavFiles" Content="Study Files" Tag="files" Click="Nav_Click" Style="{StaticResource Ghost}"/>
                        <Button x:Name="NavCode" Content="Code" Tag="code" Click="Nav_Click" Style="{StaticResource Ghost}"/>
                    </StackPanel>
                    <Border x:Name="TopBanner" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#2A2416" BorderBrush="#4D3F1E" BorderThickness="1" CornerRadius="7" Padding="12,5" Margin="16,0">
                        <TextBlock x:Name="TopBannerText" Foreground="{StaticResource Warn}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FocusText" Text="Focused" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button x:Name="NotesToggle" Content="📝  Notes" Click="NotesToggle_Click" Style="{StaticResource Ghost}" ToolTip="Show or hide notes (Ctrl+Shift+N)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="NotesColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="ContentRoot">

                <!-- ============ Browser ============ -->
                <Grid x:Name="BrowserPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <DockPanel Background="{StaticResource Bg}" Margin="10,0,10,0">
                        <Button DockPanel.Dock="Right" Content="＋" Click="NewTab_Click" Style="{StaticResource Ghost}" FontSize="15" Padding="10,2" VerticalAlignment="Bottom" Margin="4,0,0,3" ToolTip="New tab"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                        </ScrollViewer>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel Margin="8,0" VerticalAlignment="Center">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="BackBtn" Content="←" Click="Back_Click" Style="{StaticResource Ghost}" FontSize="15" Padding="10,4" ToolTip="Back"/>
                                <Button x:Name="FwdBtn" Content="→" Click="Fwd_Click" Style="{StaticResource Ghost}" FontSize="15" Padding="10,4" ToolTip="Forward"/>
                                <Button Content="⟳" Click="Reload_Click" Style="{StaticResource Ghost}" FontSize="15" Padding="10,4" ToolTip="Reload"/>
                                <Button Content="⌂" Click="Home_Click" Style="{StaticResource Ghost}" FontSize="16" Padding="10,2" ToolTip="Home"/>
                            </StackPanel>
                            <StackPanel x:Name="QuickLinks" DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="ChatGPT" Tag="https://chatgpt.com" Click="Quick_Click" Style="{StaticResource Ghost}" Padding="8,4"/>
                                <Button Content="Claude" Tag="https://claude.ai" Click="Quick_Click" Style="{StaticResource Ghost}" Padding="8,4"/>
                                <Button Content="Gemini" Tag="https://gemini.google.com" Click="Quick_Click" Style="{StaticResource Ghost}" Padding="8,4"/>
                                <Button Content="Perplexity" Tag="https://www.perplexity.ai" Click="Quick_Click" Style="{StaticResource Ghost}" Padding="8,4"/>
                                <Button Content="Scholar" Tag="https://scholar.google.com" Click="Quick_Click" Style="{StaticResource Ghost}" Padding="8,4"/>
                                <Button Content="Wikipedia" Tag="https://en.wikipedia.org" Click="Quick_Click" Style="{StaticResource Ghost}" Padding="8,4"/>
                            </StackPanel>
                            <TextBox x:Name="AddressBox" Margin="8,0" KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotFocus"/>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="BrowserHost" Grid.Row="2" Background="White"/>
                </Grid>

                <!-- ============ Study files ============ -->
                <Grid x:Name="FilesPage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                        <DockPanel Margin="12">
                            <TextBlock x:Name="FolderPath" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="4,2,4,10"/>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button x:Name="UpBtn" Content="↑ Up" Click="Up_Click" Padding="10,5" Margin="0,0,6,6"/>
                                <Button Content="New folder" Click="NewFolder_Click" Padding="10,5" Margin="0,0,6,6"/>
                                <Button Content="New note" Click="NewNote_Click" Padding="10,5" Margin="0,0,6,6"/>
                                <Button Content="Refresh" Click="Refresh_Click" Padding="10,5" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Body}" FontSize="12" Margin="4,10,4,0"
                                       Text="Double-click to open. PDF, Word, PowerPoint, Excel, images and video open here; .md / .txt open in Notes; .py / .m open in Code."/>
                            <ListBox x:Name="FileList" MouseDoubleClick="FileList_DoubleClick" KeyDown="FileList_KeyDown" DisplayMemberPath="Display"/>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="ViewerHost" Grid.Column="1">
                        <TextBlock x:Name="ViewerMessage" Style="{StaticResource Body}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" MaxWidth="460" Text="Open a file from your study folder."/>
                    </Grid>
                </Grid>

                <!-- ============ Code & notes ============ -->
                <Grid x:Name="CodePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <DockPanel Margin="12,0" VerticalAlignment="Center">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="LangPython" Content="Python" Tag="python" Click="Lang_Click" Style="{StaticResource Ghost}"/>
                                <Button x:Name="LangOctave" Content="MATLAB / Octave" Tag="octave" Click="Lang_Click" Style="{StaticResource Ghost}"/>                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock x:Name="CodeStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="New" Click="CodeNew_Click"/>
                                <Button Content="Save" Click="CodeSave_Click" ToolTip="Ctrl+S"/>
                                <Button Content="Save as…" Click="CodeSaveAs_Click"/>
                                <Button x:Name="RunBtn" Content="▶  Run" Style="{StaticResource Primary}" Click="Run_Click" ToolTip="F5"/>
                                <Button x:Name="StopBtn" Content="■  Stop" Style="{StaticResource DangerBtn}" Click="Stop_Click" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock x:Name="CodeFileLabel" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition x:Name="OutputColumn" Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Editor" Style="{StaticResource CodeBox}" AcceptsTab="True"
                                 TextChanged="Editor_TextChanged" PreviewKeyDown="Editor_PreviewKeyDown"/>
                        <GridSplitter x:Name="CodeSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>
                        <Grid x:Name="OutputPane" Grid.Column="2" Background="{StaticResource Panel}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="14,10,10,6">
                                <Button DockPanel.Dock="Right" Content="Clear" Click="ClearOutput_Click" Style="{StaticResource Ghost}" Padding="8,3"/>
                                <TextBlock Text="OUTPUT" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="OutputBox" Grid.Row="1" Style="{StaticResource CodeBox}" IsReadOnly="True" FontSize="13"
                                     TextWrapping="Wrap" Background="{StaticResource Panel}" HorizontalScrollBarVisibility="Disabled"/>
                            <ScrollViewer x:Name="FiguresScroll" Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel x:Name="FiguresPanel" Margin="8"/>
                            </ScrollViewer>
                            <StackPanel Grid.Row="3" Margin="14,6,14,14">
                                <TextBlock Text="INPUT (stdin, optional)" Style="{StaticResource Label}" Margin="0,4,0,6"/>
                                <TextBox x:Name="StdinBox" Height="54" AcceptsReturn="True" VerticalContentAlignment="Top"
                                         FontFamily="{StaticResource Mono}" FontSize="12" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============ Notes: a panel beside every page ============ -->
            <GridSplitter x:Name="NotesSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Line}" Visibility="Collapsed"/>
            <Border x:Name="NotesPanel" Grid.Column="2" Background="{StaticResource Panel}" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10,8,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Click="NotesToggle_Click" Style="{StaticResource Ghost}" Padding="9,3" ToolTip="Hide notes"/>
                            <StackPanel>
                                <TextBlock Text="NOTES" Style="{StaticResource Label}" Margin="0"/>
                                <TextBlock x:Name="NoteName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <WrapPanel DockPanel.Dock="Top" Margin="12,10,12,4">
                        <Button Content="＋ Clip page" Click="NoteClip_Click" Padding="10,5" Margin="0,0,6,6" ToolTip="Add the current web page's title and link"/>
                        <Button Content="New" Click="NoteNew_Click" Padding="10,5" Margin="0,0,6,6"/>
                        <Button Content="Open…" Click="NoteOpen_Click" Padding="10,5" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="NoteStatus" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" FontSize="11" Margin="16,6,16,10"/>
                    <Grid>
                        <TextBox x:Name="NotesBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="14.5" Padding="16,12" Background="#0B0D12"
                                 TextChanged="NotesBox_TextChanged"/>
                        <Border x:Name="NoteListPanel" Visibility="Collapsed" Background="{StaticResource Panel}">
                            <DockPanel Margin="10">
                                <DockPanel DockPanel.Dock="Top" Margin="6,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Cancel" Click="NoteListCancel_Click" Style="{StaticResource Ghost}" Padding="8,3"/>
                                    <TextBlock Text="Notes in your study folder" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                </DockPanel>
                                <TextBlock x:Name="NoteListEmpty" DockPanel.Dock="Top" Style="{StaticResource Body}" Margin="6,10" Text="No .md or .txt notes yet."/>
                                <ListBox x:Name="NoteList" DisplayMemberPath="Rel" MouseDoubleClick="NoteList_DoubleClick" KeyDown="NoteList_KeyDown"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
            </Grid>
        </Grid>

        <!-- ============ Overlays (the content behind is hidden while one is open) ============ -->
        <Grid x:Name="OverlayRoot" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource Bg}">

            <Border x:Name="IdleCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Still with it?"/>
                    <TextBlock Style="{StaticResource Body}" Text="There's been no keyboard or mouse activity for a while. Time away isn't counted as focused study."/>
                    <Button Content="I'm back, keep studying" Style="{StaticResource Primary}" Click="IdleBack_Click"
                            HorizontalAlignment="Left" Margin="0,24,0,0" Padding="18,9"/>
                </StackPanel>
            </Border>

            <Border x:Name="DistractCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="This looks off-topic"/>
                    <TextBlock x:Name="DistractTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="DistractReason" Style="{StaticResource Body}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button Content="Back to studying" Style="{StaticResource Primary}" Click="DistractBack_Click" Padding="18,9" Margin="0,0,8,0"/>
                        <Button Content="It's for my studies" Click="DistractAllow_Click" Padding="16,9"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,14,0,0"
                               Text="Be honest. Marking pages as study is counted in your session summary."/>
                </StackPanel>
            </Border>

            <Border x:Name="PickerCard" Style="{StaticResource Card}" Width="640">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Attach from your study folder"/>
                    <TextBlock Style="{StaticResource Body}" Text="During a session, only files in your study folder can be uploaded."/>
                    <Border Background="#0B0D12" CornerRadius="8" Margin="0,14,0,0" Padding="4" Height="320">
                        <Grid>
                            <ListBox x:Name="PickerList" DisplayMemberPath="Rel" MouseDoubleClick="PickerList_DoubleClick"/>
                            <TextBlock x:Name="PickerEmpty" Style="{StaticResource Body}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="Your study folder has no files yet."/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PickerError" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Attach" Style="{StaticResource Primary}" Click="PickerAttach_Click" Padding="18,9" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Click="PickerCancel_Click" Padding="16,9"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="PromptCard" Style="{StaticResource Card}" PreviewKeyDown="PromptCard_PreviewKeyDown">
                <StackPanel>
                    <TextBlock x:Name="PromptTitle" Style="{StaticResource H1}"/>
                    <TextBox x:Name="PromptBox" FontSize="15"/>
                    <TextBlock x:Name="PromptError" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="OK" Style="{StaticResource Primary}" Click="PromptOk_Click" Padding="22,9" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Click="PromptCancel_Click" Padding="16,9"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="SummaryCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="SummaryTitle" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="SummaryText" FontFamily="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource Text}"
                               TextWrapping="Wrap" LineHeight="23" Margin="0,6,0,0"/>
                    <Button Content="✕  Close Focus Study" Style="{StaticResource Primary}" Click="SummaryUnlock_Click"
                            HorizontalAlignment="Left" Margin="0,26,0,0" Padding="20,10"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

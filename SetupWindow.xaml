<Window x:Class="FocusStudy.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Study" Width="760" Height="860" MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        FontFamily="Segoe UI" Foreground="{DynamicResource Text}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,34,40,20" x:Name="Form">
                <DockPanel>
                    <Button x:Name="ThemeBtn" DockPanel.Dock="Right" VerticalAlignment="Center" Content="☀  Light"
                            Click="Theme_Click" ToolTip="Switch between light and dark mode"/>
                    <TextBlock Text="Focus Study" FontSize="30" FontWeight="SemiBold"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                           Text="Choose how long to study. Once you start, this PC becomes a distraction-free study space until the session ends."/>

                <TextBlock Style="{StaticResource Label}" Text="SESSION LENGTH"/>
                <WrapPanel>
                    <Button Content="25 min" Tag="25" Click="Preset_Click" Margin="0,0,6,6"/>
                    <Button Content="45 min" Tag="45" Click="Preset_Click" Margin="0,0,6,6"/>
                    <Button Content="1 hour" Tag="60" Click="Preset_Click" Margin="0,0,6,6"/>
                    <Button Content="1½ hours" Tag="90" Click="Preset_Click" Margin="0,0,6,6"/>
                    <Button Content="2 hours" Tag="120" Click="Preset_Click" Margin="0,0,6,6"/>
                    <Button Content="3 hours" Tag="180" Click="Preset_Click" Margin="0,0,6,6"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox x:Name="HoursBox" Width="64" HorizontalContentAlignment="Center" FontSize="16"/>
                    <TextBlock Text="hours" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,22,0"/>
                    <TextBox x:Name="MinutesBox" Width="64" HorizontalContentAlignment="Center" FontSize="16"/>
                    <TextBlock Text="minutes" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,8,0,0"
                           Text="There is no clock or countdown during the session. It simply ends when the time is up."/>

                <TextBlock Style="{StaticResource Label}" Text="STUDY FOLDER (the only folder you can open during the session)"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Style="{StaticResource Label}" Text="IDLE NUDGE"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ask if I'm still studying after" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <TextBox x:Name="IdleBox" Width="56" Margin="10,0" HorizontalContentAlignment="Center"/>
                    <TextBlock Text="minutes without keyboard / mouse activity" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0"
                           Text="Paused automatically while a lecture video or audio is playing, or while your code is running."/>

                <TextBlock Style="{StaticResource Label}" Text="BLOCKED SITES (one per line, cannot be opened)"/>
                <TextBox x:Name="BlockedBox" Height="120" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Mono}" FontSize="12"/>
                <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0"
                           Text="Other sites stay open, including AI assistants, but pages whose titles look off-topic get flagged."/>

                <TextBlock Style="{StaticResource Label}" Text="CODE ENVIRONMENTS"/>
                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="PythonStatus" FontSize="13" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button x:Name="GetOctaveBtn" DockPanel.Dock="Right" Content="Get Octave (free)" Click="GetOctave_Click" Padding="10,4"/>
                            <TextBlock x:Name="OctaveStatus" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource InfoLine}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="During a session" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="13">
                            • The app fills the screen. The taskbar, Start menu, Alt+Tab and other windows are unavailable.<LineBreak/>
                            • <Run Foreground="{DynamicResource Text}">Alt+F4</Run> starts the steps to leave early (reason → typed pledge → puzzle → cool-down).<LineBreak/>
                            • <Run Foreground="{DynamicResource Text}">Ctrl+Alt+Del</Run> stays available for emergencies.<LineBreak/>
                            • Downloads and uploads only go to and from your study folder.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="40,16">
            <DockPanel>
                <Button x:Name="StartBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Start focus session"
                        Padding="22,10" FontSize="14" Click="Start_Click"/>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock FontSize="12" Foreground="{DynamicResource Muted}">
                        Made by <Run Foreground="{DynamicResource Text}" Text="Arun VT"/> (Dusk Moon Studio)
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,2,0,0">
                        Idea by <Run Foreground="{DynamicResource Text}" Text="Aditya Kini"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
